<stat-header>
  <header>
    <hr />
    <div>
      <span>?</span>
      <span>Help</span>
    </div>
    <hr />
    <span class="text"></span>
  </header>
</stat-header>

<style>
  header {
    display: flex;
    align-items: end;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;

    & > span {
      position: absolute;
      bottom: 0.15rem;
      left: max(calc(var(--app-padding) + 6.75rem), calc(((100dvw - var(--app-max-width)) / 2) + 6.75rem));
    }
  }

  hr {
    border: none;
    margin: 0;
    height: 0.125rem;
    background-color: #646168;

    &:first-of-type {
      min-width: calc(var(--app-padding) + 1rem);
      width: calc(((100dvw - var(--app-max-width)) / 2) + 1rem);
    }

    &:last-of-type {
      flex-grow: 1;
    }
  }

  div {
    display: flex;
    justify-content: end;
    position: relative;
    font-family: 'Xoireqe';

    & > span:nth-child(1) {
      position: absolute;
      color: #6f7080;
      font-size: 3rem;
      font-style: italic;
      transform: scale(1.2, 0.6) translate(-2.1rem, -2.25rem);
    }

    & > span:nth-child(2) {
      color: #2e2b35;
      font-size: 0.75em;
      letter-spacing: 0.2rem;
      transform: translateY(0.2rem);
      padding-left: 1rem;
    }
  }
</style>

<script>
  import { HEADER_UPDATE_EVENT_TYPE, type IHeaderUpdateEvent } from '../utils/header';

  class Header extends HTMLElement {
    private abortController: AbortController | null = null;

    connectedCallback() {
      this.abortController?.abort();
      this.abortController = new AbortController();
      const signal = this.abortController.signal;
      window.addEventListener(HEADER_UPDATE_EVENT_TYPE, this.updateHeader.bind(this), { signal });
    }

    disconnectedCallback() {
      this.abortController?.abort();
      this.abortController = null;
    }

    private updateHeader(event: CustomEventInit<IHeaderUpdateEvent>) {
      const textElement = this.querySelector<HTMLSpanElement>('.text');
      if (!textElement) return;
      textElement.textContent = event.detail?.text ?? '';
    }
  }

  customElements.define('stat-header', Header);
</script>
