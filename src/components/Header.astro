---
interface Props {
  text?: string;
}

const { text } = Astro.props;
---

<header>
  <hr />
  <div>
    <span>?</span>
    <span>Help</span>
  </div>
  <hr />
  <span>{text}</span>
</header>

<style>
  header {
    display: flex;
    align-items: end;
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;

    & > span {
      position: absolute;
      bottom: 0.15rem;
      left: max(calc(var(--app-padding) + 6.75rem), calc(((100dvw - var(--app-max-width)) / 2) + 6.75rem));
    }
  }

  hr {
    border: none;
    margin: 0;
    height: 0.125rem;
    background-color: #646168;

    &:first-of-type {
      min-width: calc(var(--app-padding) + 1rem);
      width: calc(((100dvw - var(--app-max-width)) / 2) + 1rem);
    }

    &:last-of-type {
      flex-grow: 1;
    }
  }

  div {
    display: flex;
    justify-content: end;
    position: relative;
    font-family: 'Xoireqe';

    & > span:nth-child(1) {
      position: absolute;
      color: #6f7080;
      font-size: 3rem;
      font-style: italic;
      transform: scale(1.2, 0.6) translate(-2.1rem, -2.25rem);
    }

    & > span:nth-child(2) {
      color: #2e2b35;
      font-size: 0.75em;
      letter-spacing: 0.2rem;
      transform: translateY(0.2rem);
      padding-left: 1rem;
    }
  }
</style>
