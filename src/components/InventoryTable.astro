---
import { Accessory } from '../data/classes/accessory';
import { Component } from '../data/classes/component';
import { Item } from '../data/classes/item';
import { KeyItem } from '../data/classes/key-item';
import { Weapon } from '../data/classes/weapon';
import Cursor from './Cursor.astro';
import EntryButton from './EntryButton.astro';
import EntryHeader from './EntryHeader.astro';

interface Props {
  columnTitle: string;
  entries: (Item | Weapon | Accessory | Component | KeyItem)[];
}

const { columnTitle, entries } = Astro.props;

const entryPairs = entries.reduce<(typeof entries)[number][][]>(
  (acc, curr, index) => (index % 2 === 0 ? [...acc, [curr, entries[index + 1]]] : acc),
  []
);

function getEntryHeaderText(entry: (typeof entries)[number]) {
  return entry instanceof Item || entry instanceof Accessory
    ? entry.effect
    : entry instanceof Weapon || entry instanceof Component
      ? entry.description
      : '';
}
---

<inventory-table>
  <table>
    <thead>
      <tr>
        <th>
          <EntryHeader text="Item" paddingInline="0.3rem" />
          <EntryHeader text={columnTitle} align="end" paddingInline="0.3rem" />
        </th>
        <th>
          <EntryHeader text={columnTitle} align="end" paddingInline="0.3rem" />
        </th>
      </tr>
    </thead>
    <tbody>
      {
        entryPairs.map((entryPair, y) => (
          <tr>
            {entryPair.map((entry, x) =>
              entry ? (
                <td
                  data-x={x}
                  data-y={y}
                  data-c={entry instanceof Weapon ? entry.character.name : undefined}
                  data-t={getEntryHeaderText(entry)}
                >
                  <EntryButton
                    text={entry.name}
                    blackSide="right"
                    blackWidth="3rem"
                    textPaddingLeft="0.3rem"
                    textPaddingRight="4rem"
                  >
                    {(entry instanceof Item || entry instanceof Component || entry instanceof KeyItem) &&
                      entry.quantity.toString().padStart(2, '0')}
                    {entry instanceof Weapon && entry.isEquipped && (
                      <svg width="24" height="24" viewBox="0 0 24 24">
                        <path d="M20.285 2l-11.285 11.567-5.286-5.011-3.714 3.716 9 8.728 15-15.285z" fill="white" />
                      </svg>
                    )}
                  </EntryButton>
                </td>
              ) : (
                <td />
              )
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
  <Cursor selection class="m-c" />
  <Cursor glide class="s-c" />
</inventory-table>

<style>
  inventory-table {
    position: relative;
    display: flex;
  }

  table {
    flex-grow: 1;
    width: 0;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    background-color: black;
  }

  th:first-child {
    display: grid;
    grid-auto-flow: column;
  }

  :global(.m-c),
  :global(.s-c) {
    display: none;
    position: absolute;
    transform: translate(-73%, -10%);
    pointerevents: none;
  }

  :global(.m-c) {
    transition:
      0.075s top,
      0.075s left;
  }
</style>

<script>
  import { type characters } from '../data/constants/characters';
  import { updateHeader } from '../utils/header';
  import { highlightCharacter } from '../utils/party-highlighter';

  class InventoryTable extends HTMLElement {
    private static readonly SELECTED_TABLE_DATA_CLASS = 'selected';
    private selectedTableDataElement?: HTMLTableCellElement;
    private abortController: AbortController | null = null;

    connectedCallback() {
      this.abortController?.abort();
      this.abortController = new AbortController();
      const signal = this.abortController.signal;
      this.querySelector('tbody')?.addEventListener('mouseleave', this.hideMovableCursor.bind(this), { signal });
      this.querySelectorAll('td').forEach((tdElement) => {
        if (!tdElement.hasChildNodes()) return;
        tdElement.addEventListener('mouseenter', this.onTableDataMouseEnter.bind(this), { signal });
        tdElement.addEventListener('click', this.onTableDataClick.bind(this), { signal });
      });
    }

    disconnectedCallback() {
      this.abortController?.abort();
      this.abortController = null;
    }

    private moveCursor(
      cursor: 'movable' | 'selection',
      tdElement: HTMLTableCellElement,
      xCellIndex: number,
      yCellIndex: number,
      overrides?: { display?: CSSStyleDeclaration['display'] }
    ) {
      const isTdElementSelected = tdElement.classList.contains(InventoryTable.SELECTED_TABLE_DATA_CLASS);
      const trElement = tdElement.parentElement as HTMLTableRowElement;
      this.setCursorStyle(cursor, {
        display: overrides?.display ?? (isTdElementSelected ? 'none' : 'block'),
        top: `${(yCellIndex + 1) * trElement.offsetHeight}px`,
        left: `${xCellIndex * (trElement.offsetWidth / 2)}px`,
      });
    }

    private setCursorStyle(cursor: 'movable' | 'selection', style: Partial<CSSStyleDeclaration>) {
      const cursorClass = cursor === 'movable' ? 'm-c' : 's-c';
      const cursorElement = this.querySelector<HTMLElement>(`.${cursorClass}`);
      if (!cursorElement) return;
      Object.assign(cursorElement.style, style);
    }

    private hideMovableCursor() {
      this.setCursorStyle('movable', { display: 'none' });
    }

    private onTableDataMouseEnter(event: MouseEvent) {
      const tdElement = event.currentTarget as HTMLTableCellElement;
      const { x, y } = tdElement.dataset;
      this.moveCursor('movable', tdElement, Number(x), Number(y));
    }

    private onTableDataClick(event: MouseEvent) {
      const tdElement = event.currentTarget as HTMLTableCellElement;
      const { x, y, c, t } = tdElement.dataset;
      this.selectedTableDataElement?.classList.remove(InventoryTable.SELECTED_TABLE_DATA_CLASS);
      tdElement.classList.add(InventoryTable.SELECTED_TABLE_DATA_CLASS);
      this.selectedTableDataElement = tdElement;
      this.setCursorStyle('movable', { display: 'none' });
      this.moveCursor('selection', tdElement, Number(x), Number(y), { display: 'block' });
      if (c) highlightCharacter(c as keyof typeof characters);
      if (t) updateHeader(t);
    }
  }

  customElements.define('inventory-table', InventoryTable);
</script>
