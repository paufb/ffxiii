---
import Cursor from './Cursor.astro';

export interface IListItem {
  text: string;
  url?: string;
  headerText?: string;
}

interface Props {
  items: IListItem[];
  selectedItem?: IListItem;
}

const { items, selectedItem } = Astro.props;
---

<c-list>
  <ul>
    {
      items.map((item, i) => {
        const Tag = item.url ? 'a' : 'button';
        return (
          <li data-i={i} data-t={item.headerText}>
            <Tag href={item.url} class:list={{ active: selectedItem === item }}>
              {selectedItem === item && (
                <Cursor
                  glide
                  style={{
                    position: 'absolute',
                    transform: 'translateX(-100%)',
                    inset: '.55rem auto auto 35%',
                    zIndex: 1,
                  }}
                />
              )}
              <span class="text-outlined">{item.text}</span>
            </Tag>
          </li>
        );
      })
    }
  </ul>
  <Cursor
    class="movable-cursor"
    selection
    style={{
      display: 'none',
      position: 'absolute',
      inset: 'auto auto auto 35%',
      transform: 'translate(-100%, 30%)',
      pointerEvents: 'none',
      zIndex: 1,
      transition: '0.075s top',
    }}
  />
</c-list>

<style>
  c-list {
    display: block;
    position: relative;
  }

  ul {
    margin: 0;
    padding: 0;
    background: linear-gradient(to right, #1e1e1e, transparent);
    color: white;
  }

  li {
    list-style-type: none;
    position: relative;
    height: 2rem;
    background: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='100%' height='100%' viewBox='0 0 100 100'><polygon points='0,48 37,48 100,120 0,100' fill='rgb(30,30,30)' /></svg>")
      no-repeat center/cover;

    &::before {
      content: '';
      position: absolute;
      inset: 0;
      width: 100%;
      height: 0.1rem;
      background: linear-gradient(to right, #898989, transparent);
    }
  }

  a,
  button {
    display: flex;
    align-items: flex-end;
    width: 100%;
    height: 100%;
    color: inherit;
    cursor: pointer;

    & > span {
      font-weight: bold;
      position: absolute;
      inset: auto auto auto 35%;
    }
  }

  a {
    text-decoration: inherit;
  }

  button {
    border: none;
    margin: 0;
    padding: 0;
    background: none;
    font: inherit;
  }
</style>

<script>
  import { updateHeader } from '../utils/header';

  class CList extends HTMLElement {
    private abortController: AbortController | null = null;

    connectedCallback() {
      this.abortController?.abort();
      this.abortController = new AbortController();
      const signal = this.abortController.signal;
      this.addEventListener('mouseleave', this.hideMovableCursor.bind(this), { signal });
      this.querySelectorAll('li').forEach((liElement) =>
        liElement.addEventListener('mouseenter', this.moveCursorAndUpdateHeader.bind(this), { signal })
      );
    }

    disconnectedCallback() {
      this.abortController?.abort();
      this.abortController = null;
    }

    private moveCursor(liElement: HTMLLIElement, liElementIndex: number) {
      const isListItemActive = liElement.querySelector('a')?.classList.contains('active');
      this.setMovableCursorStyle({
        display: isListItemActive ? 'none' : 'block',
        top: `${liElementIndex * 32}px`,
      });
    }

    private setMovableCursorStyle(style: Partial<CSSStyleDeclaration>) {
      const movableCursor = this.querySelector<HTMLDivElement>('.movable-cursor');
      if (!movableCursor) return;
      Object.assign(movableCursor.style, style);
    }

    private hideMovableCursor() {
      this.setMovableCursorStyle({ display: 'none' });
    }

    private moveCursorAndUpdateHeader(event: MouseEvent) {
      const liElement = event.target as HTMLLIElement;
      const { i, t } = liElement.dataset;
      this.moveCursor(liElement, Number(i));
      if (t) updateHeader(t);
    }
  }

  customElements.define('c-list', CList);
</script>
