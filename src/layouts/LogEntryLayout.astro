---
import { type ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import DatalogCategoryLayout from './DatalogCategoryLayout.astro';
import { type IListItem } from '../components/List.astro';
import EntryHeader from '../components/EntryHeader.astro';
import EntryButton from '../components/EntryButton.astro';

export interface ILogEntry {
  name: string;
  slug: string;
  imageMetadata?: ImageMetadata;
  description: string;
}

interface Props {
  listItem: IListItem;
  logEntry: ILogEntry;
}

const { listItem, logEntry } = Astro.props;
---

<DatalogCategoryLayout listItem={listItem} mode="rows">
  <div class="container" slot="content-slot">
    <EntryHeader text="Page 1" paddingInline="10%" />
    <EntryButton text={logEntry.name} blackSide="right" blackWidth="65%" textPaddingLeft="10%" />
    <div>
      <section>
        {logEntry.imageMetadata && <Image src={logEntry.imageMetadata} alt={logEntry.name} />}
        <div class="text-outlined">
          {logEntry.description.split('\n').map((p) => <p>{p}</p>)}
        </div>
      </section>
    </div>
  </div>
</DatalogCategoryLayout>

<style>
  .container {
    background: linear-gradient(to bottom, black, rgba(0, 0, 0, 0.5));
  }

  section {
    --gaf: column;
    display: grid;
    grid-auto-flow: var(--gaf);
    align-items: center;
    gap: 0 1.5rem;
    margin-inline: auto;
    padding: 3rem var(--app-padding);
    max-width: calc(var(--app-max-width) - 6rem);

    @media (width < 80rem) {
      --gaf: row;
      justify-items: center;
    }
  }

  img {
    max-width: 100%;
    height: auto;
    border: 5px solid transparent;
    border-radius: 0.75rem;
    box-sizing: border-box;
    background:
      linear-gradient(white) padding-box,
      conic-gradient(#e0e2e0, #7c7f7c, #e0e2e0) border-box;
  }

  p {
    font-weight: bold;
    color: #f2f2f2;
    line-height: 1.5;
    margin-block: 1lh;
  }
</style>
