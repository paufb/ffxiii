---
import CursorWrapper from '../components/CursorWrapper.astro';
import EntryButton from '../components/EntryButton.astro';
import EntryHeader from '../components/EntryHeader.astro';
import List, { type IListItem } from '../components/List.astro';
import PartyHighlighter from '../components/PartyHighlighter.astro';
import TitleRuler from '../components/TitleRuler.astro';
import Layout from './Layout.astro';

interface Props {
  selectedNavigationMenuItem?: (typeof listItems)[number]['text'];
}

const { selectedNavigationMenuItem } = Astro.props;

const listItems = [
  { text: 'Items', url: '/inventory/items', headerText: 'View consumable items in the party inventory.' },
  { text: 'Weapons', url: '/inventory/weapons', headerText: 'View weapons in the party inventory.' },
  { text: 'Accessories', url: '/inventory/accessories', headerText: 'View accessories in the party inventory.' },
  { text: 'Components', url: '/inventory/components', headerText: 'View components in the party inventory.' },
  { text: 'Key Items', url: '/inventory/key-items', headerText: 'View key items in the party inventory.' },
] as const satisfies IListItem[];
---

<Layout>
  <div class="content">
    <aside>
      <div class="s-top col titled">
        <TitleRuler title="Inventory" alignment="end" />
        <List items={listItems} selectedItem={listItems.find((i) => i.text === selectedNavigationMenuItem)} />
      </div>
      <div class="s-bottom col titled">
        <TitleRuler title="Sort" alignment="end" />
        <div>
          <EntryHeader text="Method" align="center" />
          <CursorWrapper xPercent={39} yPercent={20} trackActive>
            <EntryButton text="Categorize" textPaddingLeft="40%" />
            <EntryButton text="Alphabetize" textPaddingLeft="40%" />
          </CursorWrapper>
        </div>
      </div>
    </aside>
    <div class="col main">
      <div class="col titled">
        <TitleRuler title="Party" alignment="start" />
        <PartyHighlighter />
      </div>
      <div class="col titled">
        <TitleRuler title="Inventory" alignment="start" />
        <div>
          <slot />
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .content {
    --gtc: 23rem 1fr;
    display: grid;
    grid-template-columns: var(--gtc);
    gap: 1rem 3.5rem;
  }

  .s-top {
    --p: sticky;
    position: var(--p);
    top: 1rem;
    align-self: start;
  }

  .s-bottom {
    --p: sticky;
    position: var(--p);
    bottom: 1rem;
    align-self: end;
  }

  aside {
    display: grid;
    gap: 1rem;
  }

  .col {
    display: flex;
    flex-direction: column;
  }

  .titled {
    gap: 0.25rem;
  }

  .main {
    gap: 1rem;
  }

  @media (width < 80rem) {
    .content {
      --gtc: auto;
      align-content: start;
    }

    .s-top,
    .s-bottom {
      --p: initial;
    }
  }
</style>
