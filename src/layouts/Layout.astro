---
import '../styles/fonts.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ?? 'FFXIII'}</title>
  </head>
  <body>
    <Header />
    <main>
      <div>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  body {
    display: grid;
    grid-template-rows: minmax(2rem, 5dvh) 1fr minmax(2rem, 5dvh);
    background: radial-gradient(ellipse at bottom, #fff, #969696) no-repeat center center fixed;
    font-family: 'Two Weekends Sans';
  }

  main {
    overflow-y: auto;

    > div {
      width: min(100%, var(--app-max-width));
      margin-inline: auto;
      padding: 1rem var(--app-padding);
      box-sizing: border-box;
    }
  }
</style>
